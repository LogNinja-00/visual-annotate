{
  "name": "visual-annotate",
  "version": "0.2.0",
  "description": "Click any element on your site during development, leave a comment, and turn it into a GitHub issue an agent can pick up with full context.",
  "type": "module",
  "bin": {
    "visual-annotate": "bin/cli.js"
  },
  "exports": {
    ".": "./src/browser.js",
    "./client": "./src/browser.js",
    "./vite": "./plugins/vite.js",
    "./webpack": "./plugins/webpack.js",
    "./server": "./server/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "server",
    "shared",
    "plugins",
    "bin",
    "CONTEXT.md",
    "README.md"
  ],
  "scripts": {
    "dev": "node bin/cli.js",
    "serve": "node bin/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "peerDependencies": {
    "vite": ">=4.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.0"
  }
}
