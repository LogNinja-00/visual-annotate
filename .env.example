GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-username-or-org
GITHUB_REPO=your-repo-name

# Optional -------------------------------------------------------------------
# Label applied to filed issues (created if missing).
VA_LABEL=visual-annotation

# Where screenshots go: github (commit into the repo) | local (temp dir) | off.
# Nothing is ever sent to a third-party host.
VA_SCREENSHOT_PROVIDER=github
VA_SCREENSHOT_BRANCH=visual-annotator-assets
VA_SCREENSHOT_DIR=.visual-annotator

# Port for the standalone server (`npx visual-annotate serve`).
VA_PORT=4545

# Pin the standalone session token. If unset, a fresh one is generated on each
# start and printed to the console.
# VA_TOKEN=
